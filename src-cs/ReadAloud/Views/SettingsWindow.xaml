<Window x:Class="ReadAloud.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Read Aloud - Settings"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Height="720"
        Width="780"
        MinHeight="560"
        MinWidth="680"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,16" />

                <GroupBox Header="Appearance" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <TextBlock Text="Color mode" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                        <ComboBox Width="240"
                                  Margin="0,4,0,0"
                                  SelectedValue="{Binding ColorMode, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="Windows default" Tag="system" />
                            <ComboBoxItem Content="Dark" Tag="dark" />
                            <ComboBoxItem Content="Light" Tag="light" />
                        </ComboBox>
                        <TextBlock Text="Theme" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
                        <ComboBox Width="240"
                                  Margin="0,4,0,0"
                                  SelectedValue="{Binding Theme, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="aurora" />
                            <ComboBoxItem Content="orbit" />
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Hotkeys" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Record"
                                    Width="80"
                                    Margin="8,0,0,0"
                                    Click="RecordRead_Click" />
                            <TextBox IsReadOnly="True" Text="{Binding HotkeyRead, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Record"
                                    Width="80"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding IsVoiceCommandEditable}"
                                    ToolTip="Voice commands are available in a later release" />
                            <TextBox IsEnabled="False" Text="Later release" />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Record"
                                    Width="80"
                                    Margin="8,0,0,0"
                                    Click="RecordStop_Click" />
                            <TextBox IsReadOnly="True" Text="{Binding HotkeyStop, Mode=OneWay}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <Button Content="Cancel recording"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Click="CancelRecording_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Capture" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <TextBlock Text="Capture mode" Foreground="{DynamicResource TextBrush}" />
                        <ComboBox Width="240"
                                  Margin="0,4,0,0"
                                  SelectedValue="{Binding CaptureMethod, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="ClipboardFirst" />
                            <ComboBoxItem Content="ClipboardOnly" />
                            <ComboBoxItem Content="UiaFirst" />
                            <ComboBoxItem Content="UiaOnly" />
                        </ComboBox>
                        <CheckBox Content="Restore clipboard after capture"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding ClipboardRestore}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Voice and playback" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <TextBlock Text="Offline voice" Foreground="{DynamicResource TextBrush}" />
                        <TextBox Margin="0,4,0,10" Text="{Binding OfflineVoice, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="SAPI rate (-10 to 10)" Foreground="{DynamicResource TextBrush}" />
                        <Slider Minimum="-10" Maximum="10" Value="{Binding SapiRate}" />
                        <TextBlock Text="Playback speed (0.5 to 3.0)" Foreground="{DynamicResource TextBrush}" />
                        <Slider Minimum="0.5" Maximum="3.0" SmallChange="0.1" Value="{Binding PlaybackSpeed}" />
                        <TextBlock Text="Volume (0 to 100)" Foreground="{DynamicResource TextBrush}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" />
                        <TextBlock Text="Maximum characters" Foreground="{DynamicResource TextBrush}" />
                        <TextBox Margin="0,4,0,0" Text="{Binding MaxChars, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Playback and mini player" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <CheckBox Content="Enable floating mini player" IsChecked="{Binding MiniPlayerEnabled}" />
                        <CheckBox Content="Keep mini player always on top" Margin="0,6,0,0" IsChecked="{Binding MiniPlayerAlwaysOnTop}" />
                        <CheckBox Content="Auto-hide mini player after playback" Margin="0,6,0,0" IsChecked="{Binding MiniPlayerAutoHide}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Automation" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <CheckBox Content="Auto-read selected text on mouse release" IsChecked="{Binding AutoReadSelection}" />
                        <TextBlock Margin="18,4,0,0"
                                   Text="While enabled, Read Aloud observes mouse-button release events to detect finished selections. It does not record keystrokes or mouse coordinates. Keyboard-only selection still uses the hotkey."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"
                                   Opacity="0.75" />
                        <CheckBox Content="Start with Windows" Margin="0,10,0,0" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="Minimize to tray" Margin="0,6,0,0" IsChecked="{Binding MinimizeToTray}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Privacy" Margin="0,0,0,14" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="8">
                        <CheckBox Content="Keep local read history" IsChecked="{Binding HistoryEnabled}" />
                        <TextBlock Text="History retention (days)" Margin="0,10,0,0" Foreground="{DynamicResource TextBrush}" />
                        <TextBox Margin="0,4,0,0" Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding PrivacyDisclosure}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <CheckBox Content="Show activity panel" Margin="0,10,0,0" IsChecked="{Binding ShowActivity}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save" Width="90" Click="Save_Click" />
            <Button Content="Close" Width="90" Margin="10,0,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
