<UserControl x:Class="ReadAloud.Views.VoiceLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="720">
            <TextBlock Text="Voice library"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Margin="0,4,0,18"
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Offline Windows voices installed on this device." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnlineEngine}" Value="True">
                                <Setter Property="Text" Value="Five Microsoft Edge neural voices plus Piper (internet required for Edge)." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadius}"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Search"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10"
                             AutomationProperties.Name="Search voices" />

                    <DockPanel Margin="0,14,0,0">
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding LanguageFilter}"
                                  MinWidth="180"
                                  AutomationProperties.Name="Filter by language" />
                        <Button DockPanel.Dock="Right"
                                Content="Clear filter"
                                Margin="10,0,0,0"
                                Padding="12,7"
                                HorizontalAlignment="Right"
                                Click="ClearFilterButton_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="No voices match these filters."
                       Margin="0,18,0,0"
                       Foreground="{DynamicResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredVoices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding FilteredVoices}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="310"
                                Margin="0,0,12,12"
                                Padding="14"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadius}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="Default"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>

                                <TextBlock Text="{Binding Description}"
                                           Margin="0,6,0,10"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Language: " /><Run Text="{Binding Language}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Gender: " /><Run Text="{Binding Gender}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Quality: " /><Run Text="{Binding QualityLabel}" />
                                </TextBlock>

                                <Button Content="Use and preview"
                                        Margin="0,12,0,0"
                                        Padding="10,6"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource AccentForegroundBrush}"
                                        Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
