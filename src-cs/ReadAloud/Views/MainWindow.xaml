<Window x:Class="ReadAloud.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReadAloud.Views"
        xmlns:vm="clr-namespace:ReadAloud.ViewModels"
        Title="Read Aloud"
        Height="640"
        Width="980"
        MinHeight="500"
        MinWidth="780"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceLibraryViewModel}">
            <views:VoiceLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,12" />
                    <TextBlock Text="Offline. Local only."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button Content="Hide to tray"
                            Margin="0,10,0,0"
                            Padding="12,8"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Hide Read Aloud to the system tray"
                            Click="HideButton_Click" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="READ ALOUD"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="8,4,0,24" />

                    <Button Content="Home"
                            Height="38"
                            Margin="0,0,0,6"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Home" />

                    <Button Content="Voice Library"
                            Height="38"
                            Margin="0,0,0,6"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            IsEnabled="{Binding NavigationEnabled[Voice Library]}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Voice Library" />

                    <Button Content="History"
                            Height="38"
                            Margin="0,0,0,6"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            IsEnabled="{Binding NavigationEnabled[History]}"
                            ToolTip="Available in a later release"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="History">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0.45" />
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Height="38"
                            Margin="0,0,0,6"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{Binding Home}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedNavigation}" Value="Voice Library">
                            <Setter Property="Content" Value="{Binding VoiceLibrary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedNavigation}" Value="History">
                            <Setter Property="Content" Value="{Binding History}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
