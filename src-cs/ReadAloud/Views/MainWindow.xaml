<Window x:Class="ReadAloud.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReadAloud.Views"
        Title="Read Aloud"
        Height="620"
        Width="960"
        MinHeight="480"
        MinWidth="760"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundBrush}"
                Padding="18">
            <StackPanel>
                <TextBlock Text="READ ALOUD"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="8,4,0,28" />

                <Button Content="Home"
                        Height="40"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Padding="14,0"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White" />

                <Button Content="Voice Library"
                        Height="40"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Padding="14,0"
                        IsEnabled="False"
                        ToolTip="Available in a later release">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.45" />
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="History"
                        Height="40"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Padding="14,0"
                        IsEnabled="False"
                        ToolTip="Available in a later release">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.45" />
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Settings"
                        Height="40"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Padding="14,0" />
            </StackPanel>
        </Border>

        <views:HomeView Grid.Column="1" />
    </Grid>
</Window>
