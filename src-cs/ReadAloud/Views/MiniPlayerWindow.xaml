<Window x:Class="ReadAloud.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Read Aloud — Now playing"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="430"
        Height="216"
        MinHeight="190"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="{DynamicResource BackgroundBrush}">
    <Border Padding="14"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadius}">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="READ ALOUD"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button Content="Expand"
                            Padding="8,3"
                            AutomationProperties.Name="Expand Read Aloud"
                            Click="ExpandButton_Click" />
                    <Button Content="Close"
                            Margin="6,0,0,0"
                            Padding="8,3"
                            AutomationProperties.Name="Close mini player"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding State.Text}"
                       MaxHeight="54"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource TextBrush}" />

            <ProgressBar Height="4"
                         Margin="0,12,0,6"
                         Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource SubtleBrush}"
                         AutomationProperties.Name="Playback progress" />

            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding ElapsedText}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding RemainingText}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>

            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Speed"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ComboBox ItemsSource="{Binding SpeedOptions}"
                          SelectedItem="{Binding SelectedSpeed}"
                          AutomationProperties.Name="Playback speed"
                          MinWidth="90"
                          HorizontalAlignment="Right" />
            </DockPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Previous"
                        Padding="10,5"
                        AutomationProperties.Name="Previous sentence"
                        Command="{Binding SkipPreviousCommand}" />
                <Button Content="{Binding PauseResumeLabel}"
                        Margin="6,0,0,0"
                        Padding="10,5"
                        IsEnabled="{Binding CanPauseResume}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentForegroundBrush}"
                        Command="{Binding PauseResumeCommand}" />
                <Button Content="Next"
                        Margin="6,0,0,0"
                        Padding="10,5"
                        AutomationProperties.Name="Next sentence"
                        Command="{Binding SkipNextCommand}" />
                <Button Content="Stop"
                        Margin="6,0,0,0"
                        Padding="10,5"
                        Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
