<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F1727" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AAEC8" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#7E90A8" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#131E2F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#27364D" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#1B2A40" />
    <CornerRadius x:Key="CornerRadius">10</CornerRadius>
</ResourceDictionary>
